# Required
POSTGRES_PASSWORD=change-me

# RUIAN (optional)
RUIAN_DATABASE_URL=            # empty = compose Postgres, database `ruian`
RUIAN_IMPORT=                  # `true` = run the n8n import before Langflow starts
RUIAN_DB=ruian                 # target database of the n8n import
RUIAN_MAX_FILES=0              # 0 = all CSV files

# Not read by docker compose. Export these in your shell (see README "Setup").
LANGFLOW_API_KEY=Add new in http://localhost:7860/settings/api-keys
LANGFLOW_LOCAL_API_KEY=
LANGFLOW_STAGING_API_KEY=
LANGFLOW_PROD_API_KEY=

# LLM for the agent flows (empty = local LiteLLM, openrouter-gemma)
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=
LITELLM_NETWORK=               # empty = aiag-hw_default
